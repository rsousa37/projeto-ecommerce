{
  "name": "mini-loja",
  "version": "1.0.0",
  "description": "E-commerce acadêmico simples (HTML, CSS e JavaScript puro)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:unit": "node --test tests/unit/loja.unit.test.js",
    "test:integration": "node --test tests/integration/fluxo-compra.integration.test.js",
    "test": "npm run test:unit && npm run test:integration",
    "coverage": "c8 --include=src/js/loja.js --reporter=text --reporter=html --reporter=lcov --check-coverage --lines=90 --statements=90 --functions=90 --branches=80 node --test tests/unit/loja.unit.test.js tests/integration/fluxo-compra.integration.test.js",
    "start": "serve src -l 8080"
  },
  "devDependencies": {
    "c8": "^10.1.2"
  },
  "dependencies": {
    "serve": "^14.2.8"
  }
}
